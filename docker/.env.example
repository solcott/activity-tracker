# Secrets for the local PDS. Dev-only values; never reuse them anywhere real.
PDS_JWT_SECRET=local-dev-jwt-secret-change-me
PDS_ADMIN_PASSWORD=local-dev-admin-password
# 32-byte secp256k1 private key, hex. Generate a fresh one with: openssl rand -hex 32
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=5a1f0b8c2d9e4f7a6b3c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f00

# Test account created by scripts/create-account.sh (password used for every local test account).
TEST_ACCOUNT_PASSWORD=local-dev-password

# Basic-auth password for the local relay's /admin API (user "admin").
RELAY_ADMIN_PASSWORD=local-dev-relay-admin

# DID of lexicons.test, which publishes our space-type lexicons for the PDS to resolve. Left empty here:
# scripts/dev.sh creates the account and writes its DID (it comes from the PLC, so it can't be fixed).
PDS_LEXICON_AUTHORITY_DID=

# The AppView's P-256 private key (64 hex chars), published as #atproto in its DID document and used to sync
# athletes' tier spaces. Left empty here: scripts/dev.sh generates one. Without it the AppView serves public data only.
APPVIEW_SIGNING_KEY=

# The labeler (Ozone): moderation.test's DID, written by docker/scripts/setup-labeler.sh (it comes from the PLC, so it
# can't be fixed); its secp256k1 label-signing key (64 hex chars), which setup-labeler.sh generates and publishes as
# #atproto_label; and the password for Ozone's admin API (Basic auth, user "admin").
OZONE_SERVER_DID=
OZONE_SIGNING_KEY_HEX=
OZONE_ADMIN_PASSWORD=local-dev-ozone-admin

# The AppView's own account on Ozone's team (triage.test, read-only triage role) and an app password for it, written by
# setup-labeler.sh. The AppView signs in with them to check a reported subject's review status for moderators.
APPVIEW_TRIAGE_DID=
APPVIEW_TRIAGE_PASSWORD=

# How many distinct athletes' efforts make a proposed segment active (segments/segment-records), the creator included.
# Empty means 3. Locally, 1 or 2 lets a segment go active without seeding three riders.
SEGMENT_ACTIVE_ATHLETES=

# The one account allowed to stage candidate segments in the AppView and read which are ridden (segments/segment-candidates),
# such as a <name>.test account's DID. Empty refuses every candidate call.
SEGMENT_IMPORTER_DID=
# How many distinct athletes' passes make a staged candidate ridden. Empty means 3.
SEGMENT_CANDIDATE_RIDERS=

# The segment importer's service account (segments/segment-import), for `stage` and `publish` and scripts/segment-import.sh. Locally,
# docker/scripts/create-account.sh importer makes importer.test; put its DID in SEGMENT_IMPORTER_DID above. Elsewhere use an app password.
SEGMENT_IMPORTER_IDENTIFIER=
SEGMENT_IMPORTER_PASSWORD=
SEGMENT_IMPORTER_PDS_URL=http://localhost:2583
# The AppView the importer calls; empty means the local one (http://localhost:8081, did:web:localhost%3A8081).
APPVIEW_URL=
APPVIEW_DID=
