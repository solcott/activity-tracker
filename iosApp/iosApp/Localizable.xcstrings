    "settings_groups_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links your activities with others' you did together, like a ride with friends. Shares a copy of your routes, with your privacy zones and hidden starts and ends removed, with the app's server so it can tell who you were with. No one else sees it. \"People I follow\" groups you only with people you follow or who follow you; \"Anyone\" with anyone who also chose to be grouped. A partner is shown only to people who may see their activity, its start time and its map. You can leave the group on any activity."
          }
        }
      }
    },
