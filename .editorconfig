root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Formatting is ktfmt (kotlinlang style); this keeps the IDE's wrap guide in step.
max_line_length = 140

[*.{json,yaml,yml,toml,md}]
indent_size = 2

[*.sh]
# shfmt reads these (LintConventionPlugin.kt: `./gradlew formatShell`, checked by `lintShfmt`).
indent_size = 2
binary_next_line = false
switch_case_indent = true
space_redirects = false
