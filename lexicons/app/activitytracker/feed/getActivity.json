{
  "lexicon": 1,
  "id": "app.activitytracker.feed.getActivity",
  "defs": {
    "main": {
      "type": "query",
      "description": "A single activity. Its comments are listed by app.activitytracker.feed.getComments.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "at-uri" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["activity"],
          "properties": {
            "activity": { "type": "ref", "ref": "app.activitytracker.feed.defs#activityView" },
            "comments": {
              "type": "array",
              "items": { "type": "ref", "ref": "app.activitytracker.feed.defs#commentView" },
              "description": "Deprecated: always empty, kept for clients that still read it. Use app.activitytracker.feed.getComments."
            }
          }
        }
      },
      "errors": [{ "name": "NotFound" }]
    }
  }
}
