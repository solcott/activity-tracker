{
  "lexicon": 1,
  "id": "app.activitytracker.feed.activity",
  "defs": {
    "main": {
      "type": "record",
      "description": "A recorded or manually entered athletic activity. Records are public: never include private locations; privacy zones must be trimmed from polyline/track before writing.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["sport", "startedAt", "elapsedTime", "createdAt"],
        "properties": {
          "sport": {
            "type": "string",
            "maxLength": 64,
            "description": "Activity type, following Garmin's activity profiles plus types Apple Health, Health Connect and Strava track.",
            "knownValues": ["run", "ride", "handcycle", "swim", "multisport", "waterFitness", "walk", "hike", "rucking", "mountaineering", "climb", "inlineSkate", "horseback", "golf", "discGolf", "archery", "hunt", "fish", "adventureRace", "expedition", "wheelchair", "skateboard", "kickScooter", "orienteering", "parkour", "ski", "snowboard", "xcSki", "snowshoe", "iceSkate", "curling", "row", "kayak", "canoe", "sup", "surf", "kiteboard", "windsurf", "sail", "wakeboard", "wakesurf", "waterSki", "whitewater", "tube", "snorkel", "boat", "dive", "strength", "cardio", "hiit", "yoga", "pilates", "mobility", "elliptical", "stairStepper", "floorClimb", "jumpRope", "boxing", "mma", "wrestling", "fencing", "taiChi", "dance", "gymnastics", "recovery", "soccer", "americanFootball", "baseball", "softball", "basketball", "volleyball", "iceHockey", "fieldHockey", "lacrosse", "rugby", "cricket", "ultimate", "handball", "waterPolo", "australianFootball", "rollerHockey", "floorball", "tennis", "pickleball", "padel", "badminton", "squash", "racquetball", "tableTennis", "platformTennis", "motorcycle", "motocross", "atv", "snowmobile", "overland", "meditation", "breathwork", "flying", "skydive", "gaming", "bowling", "play", "yardWork", "housework", "other"]
          },
          "subSport": {
            "type": "string",
            "maxLength": 64,
            "description": "Refines sport (a mountain-bike ride, a treadmill run). Meaningful only together with sport; absent for the sport's generic form.",
            "knownValues": ["trail", "treadmill", "track", "indoorTrack", "virtual", "ultra", "obstacle", "road", "mountain", "gravel", "cyclocross", "indoor", "eBike", "eMountain", "commute", "tour", "bmx", "pool", "openWater", "triathlon", "duathlon", "swimrun", "brick", "mixed", "bouldering", "backcountry", "classic", "skate", "race", "expedition", "singleGas", "multiGas", "ccr", "gauge", "apnea", "apneaHunt", "poolApnea", "walkPace", "runPace", "nordic", "roller", "functional", "crossfit", "calisthenics", "bootcamp", "circuit", "cardio", "social", "paragliding", "velomobile", "dog", "stroller", "futsal", "beach", "kickboxing", "barre", "step", "core", "stretching", "cooldown", "sauna", "coldPlunge"]
          },
          "title": { "type": "string", "maxLength": 1000, "maxGraphemes": 100 },
          "description": { "type": "string", "maxLength": 10000, "maxGraphemes": 1000 },
          "startedAt": { "type": "string", "format": "datetime" },
          "elapsedTime": { "type": "integer", "minimum": 0, "description": "Wall-clock duration in seconds." },
          "movingTime": { "type": "integer", "minimum": 0, "description": "Seconds spent moving." },
          "distance": { "type": "integer", "minimum": 0, "description": "Meters." },
          "elevationGain": { "type": "integer", "minimum": 0, "description": "Meters." },
          "avgSpeed": { "type": "integer", "minimum": 0, "description": "Millimeters per second (lexicons have no floats)." },
          "maxSpeed": { "type": "integer", "minimum": 0, "description": "Millimeters per second." },
          "avgHeartRate": { "type": "integer", "minimum": 0, "maximum": 300 },
          "maxHeartRate": { "type": "integer", "minimum": 0, "maximum": 300 },
          "avgTemperature": { "type": "integer", "description": "Tenths of a degree Celsius (lexicons have no floats). May be negative." },
          "polyline": {
            "type": "string",
            "maxLength": 50000,
            "description": "Simplified route as a Google encoded polyline (precision 5), for feed/map previews."
          },
          "track": {
            "type": "blob",
            "accept": ["application/gpx+xml"],
            "maxSize": 10000000,
            "description": "Full-resolution GPS track as GPX."
          },
          "device": { "type": "string", "maxLength": 256 },
          "sensors": {
            "type": "array",
            "maxLength": 16,
            "items": { "type": "ref", "ref": "#sensor" },
            "description": "Sensors paired with the recording device. Make and model only: never serial numbers or battery state."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "sensor": {
      "type": "object",
      "description": "A sensor paired with the recording device, such as a heart rate strap or a power meter.",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 64,
          "knownValues": ["heartRate", "power", "speedCadence", "speed", "cadence", "shifting", "radar", "light", "trainer", "footpod", "other"]
        },
        "manufacturer": { "type": "string", "maxLength": 128, "description": "Its maker, e.g. \"Garmin\"." },
        "model": { "type": "string", "maxLength": 128, "description": "Its model, e.g. \"HRM 200\"; absent when only its maker can name it." }
      }
    }
  }
}
