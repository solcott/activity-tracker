{
  "lexicon": 1,
  "id": "app.activitytracker.feed.getAuthorPosts",
  "defs": {
    "main": {
      "type": "query",
      "description": "An athlete's posts the viewer may see (feed/posts), newest first by feed position. Blocks either way hide them all; mutes don't.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["posts"],
          "properties": {
            "cursor": { "type": "string" },
            "posts": { "type": "array", "items": { "type": "ref", "ref": "app.activitytracker.feed.defs#postView" } }
          }
        }
      }
    }
  }
}
