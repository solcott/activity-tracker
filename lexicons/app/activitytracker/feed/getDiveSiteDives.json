{
  "lexicon": 1,
  "id": "app.activitytracker.feed.getDiveSiteDives",
  "defs": {
    "main": {
      "type": "query",
      "description": "A dive site's visits the viewer may see (each at the narrowest of its activity's visibility and its Map category's), newest first, as the dives' activity views.",
      "parameters": {
        "type": "params",
        "required": ["site"],
        "properties": {
          "site": { "type": "string", "format": "at-uri" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 30 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["dives"],
          "properties": {
            "cursor": { "type": "string" },
            "dives": { "type": "array", "items": { "type": "ref", "ref": "app.activitytracker.feed.defs#activityView" } }
          }
        }
      },
      "errors": [{ "name": "NotFound", "description": "The site isn't indexed, or isn't served (as for getDiveSite)." }]
    }
  }
}
