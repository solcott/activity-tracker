{
  "lexicon": 1,
  "id": "app.activitytracker.feed.comment",
  "defs": {
    "main": {
      "type": "record",
      "description": "A comment on an activity.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "text", "createdAt"],
        "properties": {
          "subject": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "text": { "type": "string", "maxLength": 10000, "maxGraphemes": 1000 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
