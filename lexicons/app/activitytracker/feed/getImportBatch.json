{
  "lexicon": 1,
  "id": "app.activitytracker.feed.getImportBatch",
  "defs": {
    "main": {
      "type": "query",
      "description": "An athlete's activities from one batch import (feed.activity#importBatch) that the viewer may see, recent ones included, newest started first. Combined activities show in place of their members. An unknown batch gives an empty list.",
      "parameters": {
        "type": "params",
        "required": ["actor", "batch"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" },
          "batch": { "type": "string", "format": "tid" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["activities"],
          "properties": {
            "cursor": { "type": "string" },
            "activities": { "type": "array", "items": { "type": "ref", "ref": "app.activitytracker.feed.defs#activityView" } }
          }
        }
      },
      "errors": [{ "name": "ActorNotFound", "description": "No athlete has that DID or handle." }]
    }
  }
}
