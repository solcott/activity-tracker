{
  "lexicon": 1,
  "id": "app.activitytracker.feed.getLikes",
  "defs": {
    "main": {
      "type": "query",
      "description": "Athletes who liked an activity, most recently indexed first. Each athlete is listed once. Lists only athletes who, like the viewer, may see the activity at its current visibility; a viewer who may not see it gets no likes.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "at-uri" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "likes"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "cursor": { "type": "string" },
            "likes": { "type": "array", "items": { "type": "ref", "ref": "app.activitytracker.actor.defs#profileViewBasic" } }
          }
        }
      },
      "errors": [{ "name": "NotFound" }]
    }
  }
}
