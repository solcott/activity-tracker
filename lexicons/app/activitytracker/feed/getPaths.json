{
  "lexicon": 1,
  "id": "app.activitytracker.feed.getPaths",
  "defs": {
    "main": {
      "type": "query",
      "description": "The views of up to 25 trails and roads (segments/segment-paths), leaving out those not indexed.",
      "parameters": {
        "type": "params",
        "required": ["uris"],
        "properties": { "uris": { "type": "array", "minLength": 1, "maxLength": 25, "items": { "type": "string", "format": "at-uri" } } }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["paths"],
          "properties": { "paths": { "type": "array", "items": { "type": "ref", "ref": "app.activitytracker.feed.defs#pathView" } } }
        }
      },
      "errors": [{ "name": "InvalidRequest", "description": "More than 25 URIs." }]
    }
  }
}
