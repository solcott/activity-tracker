{
  "lexicon": 1,
  "id": "app.activitytracker.feed.getTimeline",
  "defs": {
    "main": {
      "type": "query",
      "description": "Activities from athletes the viewer follows, plus the viewer's own, newest first. Requires auth.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["activities"],
          "properties": {
            "cursor": { "type": "string" },
            "activities": { "type": "array", "items": { "type": "ref", "ref": "app.activitytracker.feed.defs#activityView" } }
          }
        }
      }
    }
  }
}
