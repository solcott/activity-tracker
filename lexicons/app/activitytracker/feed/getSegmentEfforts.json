{
  "lexicon": 1,
  "id": "app.activitytracker.feed.getSegmentEfforts",
  "defs": {
    "main": {
      "type": "query",
      "description": "One athlete's efforts on a segment that the viewer may see, fastest first. An actor the AppView doesn't know has none.",
      "parameters": {
        "type": "params",
        "required": ["segment", "actor"],
        "properties": {
          "segment": { "type": "string", "format": "at-uri" },
          "actor": { "type": "string", "format": "at-identifier" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["efforts"],
          "properties": {
            "cursor": { "type": "string" },
            "efforts": { "type": "array", "items": { "type": "ref", "ref": "app.activitytracker.feed.defs#effortView" } }
          }
        }
      },
      "errors": [{ "name": "NotFound", "description": "The segment isn't indexed, or isn't served (as for getSegment)." }]
    }
  }
}
