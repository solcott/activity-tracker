{
  "lexicon": 1,
  "id": "app.activitytracker.gear.getActorGear",
  "defs": {
    "main": {
      "type": "query",
      "description": "An athlete's gear items the viewer may see, each with its totals for the viewer: items in use first, then by name.",
      "parameters": {
        "type": "params",
        "required": [
          "actor"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "format": "at-identifier"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 30
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "app.activitytracker.gear.defs#actorGearItem"
              }
            }
          }
        }
      }
    }
  }
}
