{
  "lexicon": 1,
  "id": "app.activitytracker.graph.getMutes",
  "defs": {
    "main": {
      "type": "query",
      "description": "Accounts the requesting athlete mutes, newest first. Only ever the caller's own mutes. Requires auth.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["mutes"],
          "properties": {
            "cursor": { "type": "string" },
            "mutes": { "type": "array", "items": { "type": "ref", "ref": "app.activitytracker.actor.defs#profileViewBasic" } }
          }
        }
      }
    }
  }
}
