{
  "lexicon": 1,
  "id": "app.activitytracker.graph.getFollowers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Athletes who follow an actor, most recently indexed first.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subject", "followers"],
          "properties": {
            "subject": { "type": "ref", "ref": "app.activitytracker.actor.defs#profileViewBasic" },
            "cursor": { "type": "string" },
            "followers": { "type": "array", "items": { "type": "ref", "ref": "app.activitytracker.actor.defs#profileViewBasic" } }
          }
        }
      },
      "errors": [{ "name": "ActorNotFound" }]
    }
  }
}
