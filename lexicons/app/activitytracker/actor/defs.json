{
  "lexicon": 1,
  "id": "app.activitytracker.actor.defs",
  "defs": {
    "profileViewBasic": {
      "type": "object",
      "required": ["did", "handle"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
        "avatar": { "type": "string", "format": "uri", "description": "URL of the athlete's profile picture." }
      }
    },
    "profileView": {
      "type": "object",
      "required": ["did", "handle"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
        "description": { "type": "string", "maxLength": 2560, "maxGraphemes": 256 },
        "avatar": { "type": "string", "format": "uri", "description": "URL of the athlete's profile picture." },
        "details": {
          "type": "ref",
          "ref": "#details",
          "description": "Only the details this viewer may see: public ones, plus mutuals-only ones for a mutual and everything for the athlete themselves."
        },
        "units": { "type": "string", "knownValues": ["metric", "imperial"] },
        "activitiesCount": { "type": "integer" },
        "followersCount": { "type": "integer" },
        "followsCount": { "type": "integer" },
        "viewer": { "type": "ref", "ref": "#viewerState" }
      }
    },
    "viewerState": {
      "type": "object",
      "properties": {
        "following": { "type": "string", "format": "at-uri", "description": "URI of the viewer's follow record, if any." }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "locality": { "type": "string", "maxLength": 640, "maxGraphemes": 64, "description": "City or town." },
        "region": { "type": "string", "maxLength": 640, "maxGraphemes": 64, "description": "State, province or similar." },
        "country": { "type": "string", "minLength": 2, "maxLength": 2, "description": "ISO 3166-1 alpha-2 code, upper case." }
      }
    },
    "details": {
      "type": "object",
      "description": "Optional athlete details. Each is stored in the public profile record only when the athlete makes it public; otherwise it lives in the AppView's private store (see putPrivateDetails).",
      "properties": {
        "location": { "type": "ref", "ref": "#location" },
        "birthDate": { "type": "string", "minLength": 10, "maxLength": 10, "description": "Calendar date as YYYY-MM-DD." },
        "gender": {
          "type": "string",
          "maxLength": 640,
          "maxGraphemes": 64,
          "knownValues": ["female", "male", "nonBinary"],
          "description": "A known value, or the athlete's own description."
        },
        "weight": { "type": "integer", "minimum": 1, "maximum": 500000, "description": "Grams (lexicons have no floats)." },
        "training": { "type": "ref", "ref": "#training", "description": "Training thresholds and zone models." }
      }
    },
    "training": {
      "type": "object",
      "description": "The athlete's training thresholds, and the models their heart rate and power zones are derived from.",
      "properties": {
        "functionalThresholdPower": { "type": "integer", "minimum": 1, "maximum": 2500, "description": "Cycling FTP in watts." },
        "maxHeartRate": { "type": "integer", "minimum": 20, "maximum": 250, "description": "Beats per minute." },
        "thresholdHeartRate": { "type": "integer", "minimum": 20, "maximum": 250, "description": "Lactate threshold heart rate, beats per minute." },
        "restingHeartRate": { "type": "integer", "minimum": 20, "maximum": 250, "description": "Beats per minute." },
        "heartRateZoneModel": {
          "type": "string",
          "maxLength": 64,
          "knownValues": ["frielRunning", "frielCycling", "cogganHeartRate", "percentMaxHeartRate", "heartRateReserve"],
          "description": "How heart rate zones are derived from the thresholds."
        },
        "powerZoneModel": {
          "type": "string",
          "maxLength": 64,
          "knownValues": ["coggan6", "coggan7"],
          "description": "How power zones are derived from functionalThresholdPower."
        },
        "autoUpdate": {
          "type": "array",
          "maxLength": 4,
          "items": {
            "type": "string",
            "maxLength": 64,
            "knownValues": ["functionalThresholdPower", "maxHeartRate", "thresholdHeartRate", "restingHeartRate"]
          },
          "description": "The thresholds that imported activities may update from the recording device's settings."
        },
        "setAt": { "type": "ref", "ref": "#trainingSetAt", "description": "When each threshold took effect." },
        "sports": {
          "type": "array",
          "maxLength": 16,
          "items": { "type": "ref", "ref": "#sportTraining" },
          "description": "Per-sport overrides, at most one per sport. The fields above are the defaults: an activity of a sport listed here uses that entry's values where it sets them, and the defaults otherwise."
        }
      }
    },
    "sportTraining": {
      "type": "object",
      "description": "Thresholds and zone models for one sport, overriding the defaults in #training. Resting heart rate is not per sport.",
      "required": ["sport"],
      "properties": {
        "sport": {
          "type": "string",
          "maxLength": 64,
          "knownValues": ["run", "ride", "swim", "row", "xcSki", "walk", "hike"],
          "description": "The sport of an app.activitytracker.feed.activity record."
        },
        "functionalThresholdPower": { "type": "integer", "minimum": 1, "maximum": 2500, "description": "Threshold power for this sport, in watts." },
        "maxHeartRate": { "type": "integer", "minimum": 20, "maximum": 250, "description": "Beats per minute." },
        "thresholdHeartRate": { "type": "integer", "minimum": 20, "maximum": 250, "description": "Lactate threshold heart rate, beats per minute." },
        "thresholdSpeed": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000,
          "description": "Threshold speed, millimeters per second (lexicons have no floats). Clients show it as a pace."
        },
        "heartRateZoneModel": { "type": "string", "maxLength": 64, "knownValues": ["frielRunning", "frielCycling", "cogganHeartRate", "percentMaxHeartRate", "heartRateReserve"] },
        "powerZoneModel": { "type": "string", "maxLength": 64, "knownValues": ["coggan6", "coggan7"] },
        "speedZoneModel": {
          "type": "string",
          "maxLength": 64,
          "knownValues": ["frielRunning", "frielSwimming"],
          "description": "How speed zones are derived from thresholdSpeed."
        },
        "setAt": { "type": "ref", "ref": "#trainingSetAt", "description": "When each of this sport's thresholds took effect." }
      }
    },
    "trainingSetAt": {
      "type": "object",
      "description": "When each threshold took effect: when the athlete set it, or the start of the activity it was read from. An import only updates a threshold from an activity that started later.",
      "properties": {
        "functionalThresholdPower": { "type": "string", "format": "datetime" },
        "maxHeartRate": { "type": "string", "format": "datetime" },
        "thresholdHeartRate": { "type": "string", "format": "datetime" },
        "restingHeartRate": { "type": "string", "format": "datetime" },
        "thresholdSpeed": { "type": "string", "format": "datetime" }
      }
    },
    "visibility": {
      "type": "string",
      "knownValues": ["public", "mutuals", "self"],
      "description": "Who may see a detail: anyone, accounts the athlete and the viewer both follow, or only the athlete."
    },
    "detailsVisibility": {
      "type": "object",
      "description": "Visibility of each detail group in #details.",
      "properties": {
        "location": { "type": "ref", "ref": "#visibility" },
        "birthDate": { "type": "ref", "ref": "#visibility" },
        "gender": { "type": "ref", "ref": "#visibility" },
        "weight": { "type": "ref", "ref": "#visibility" },
        "training": { "type": "ref", "ref": "#visibility" }
      }
    }
  }
}
