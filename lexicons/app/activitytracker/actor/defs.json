{
  "lexicon": 1,
  "id": "app.activitytracker.actor.defs",
  "defs": {
    "profileViewBasic": {
      "type": "object",
      "required": ["did", "handle"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": { "type": "string", "maxLength": 640, "maxGraphemes": 64 }
      }
    },
    "profileView": {
      "type": "object",
      "required": ["did", "handle"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
        "description": { "type": "string", "maxLength": 2560, "maxGraphemes": 256 },
        "units": { "type": "string", "knownValues": ["metric", "imperial"] },
        "activitiesCount": { "type": "integer" },
        "followersCount": { "type": "integer" },
        "followsCount": { "type": "integer" },
        "viewer": { "type": "ref", "ref": "#viewerState" }
      }
    },
    "viewerState": {
      "type": "object",
      "properties": {
        "following": { "type": "string", "format": "at-uri", "description": "URI of the viewer's follow record, if any." }
      }
    }
  }
}
