{
  "lexicon": 1,
  "id": "app.activitytracker.actor.getPrivateDetails",
  "defs": {
    "main": {
      "type": "query",
      "description": "The caller's own non-public profile details and their visibility. Requires auth.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["details", "visibility"],
          "properties": {
            "details": { "type": "ref", "ref": "app.activitytracker.actor.defs#details" },
            "visibility": { "type": "ref", "ref": "app.activitytracker.actor.defs#detailsVisibility" }
          }
        }
      }
    }
  }
}
