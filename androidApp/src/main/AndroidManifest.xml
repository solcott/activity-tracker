<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Recording goes on with the screen off (record/gps-recording): a location foreground service and its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ActivityTrackerApplication"
        android:label="@string/app_name"
        android:theme="@style/Theme.ActivityTracker">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ATProto OAuth redirect: <scheme>:/oauth/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${oauthRedirectScheme}" />
            </intent-filter>
        </activity>
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="location">
            <intent-filter>
                <!-- AndroidRecordingForeground.ACTION_START, sent in this package only. -->
                <action android:name="io.github.solcott.activitytracker.recording.START" />
            </intent-filter>
        </service>
    </application>
</manifest>
