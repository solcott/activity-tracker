<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher label; in-app text lives in composeApp's composeResources. -->
    <string name="app_name">Activity Tracker</string>
    <!-- The ongoing notification while a GPS recording is in progress (record/gps-recording). -->
    <string name="recording_channel">Recording</string>
    <string name="recording_title">Recording</string>
    <string name="recording_paused_title">Recording paused</string>
    <!-- Elapsed time, then distance, e.g. "42:10 · 15.3 km". -->
    <string name="recording_text">%1$s · %2$s</string>
    <string name="recording_pause">Pause</string>
    <string name="recording_resume">Resume</string>
    <!-- The quiet notification while imports upload in the background (data/upload-queue). -->
    <string name="uploads_channel">Uploads</string>
    <string name="uploads_title">Uploading imported activities</string>
    <!-- Activities uploaded, then all the imports saved, e.g. "412 of 1362 uploaded". -->
    <string name="uploads_text">%1$d of %2$d uploaded</string>
    <!-- The foreground notification while a batch import is saved, with the app in the background (feed/batch-import). -->
    <string name="saving_title">Saving imported activities</string>
    <!-- Activities saved, then all selected, e.g. "120 of 400 saved". -->
    <string name="saving_text">%1$d of %2$d saved</string>
    <string name="unit_km">km</string>
    <string name="unit_mi">mi</string>
</resources>
